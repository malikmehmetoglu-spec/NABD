# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# مفتاح سري — على الخادم فقط (Vercel: نوع Sensitive). تستخدمه لوحة الأدمن لإنشاء الحسابات
# وإعادة تعيين كلمات المرور. لا تضع NEXT_PUBLIC_ قبل اسمه أبداً.
SUPABASE_SECRET_KEY=sb_secret_xxx
